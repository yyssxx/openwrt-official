# ============================================================
# 官方 OpenWrt 24.10 树种子配置：Xiaomi AX3000T（原厂布局）
# 用法：工作流里 CONFIG_FILE 指向本文件，defconfig 会展开成完整 .config。
# 选包口径 = config-ax3000t.frpc（Yu 2026-11-06 定版），仅两处偏差见 PREP-NOTES.md：
#   1) naive 走双路：加回 naiveproxy + INCLUDE_NaiveProxy（理由见 PREP-NOTES）
#   2) xfrpc 已按既定决定换成官方 frpc（.frpc 本来就是这么改的，此处沿用）
# ============================================================

# ---- 目标设备（官方树设备名） ----
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y

# ---- 基础 ----
CONFIG_PACKAGE_dnsmasq-full=y
# dnsmasq 本体必须钉 =m（只编不装）：run 42747277220 实测教训——种子不写这行时
# defconfig 会按 CONFIG_DEFAULT_dnsmasq=y 把原版 dnsmasq 也装进镜像，与 -full 版
# 18 个文件冲突，package/install 阶段 opkg 直接判死（地雷埋在最后一步）。
# 写法与 Yu 本地 config-15 的已验证组合一致；full 的功能开关也照 config-15 对齐。
CONFIG_PACKAGE_dnsmasq=m
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
# CONFIG_PACKAGE_dnsmasq_full_ipset is not set
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y
# NAT6 / 老 iptables 兼容四件（与 Yu 本地 config-15 对齐补入）：核心 IPv6 本就齐
# （odhcp6c/odhcpd-ipv6only/luci-proto-ipv6 官方默认带），这四件补的是 NAT6 与
# ip6tables 兼容层，老脚本调用 ip6tables 时才用得上，体积小，一并对齐。
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_luci=y
# 语言总开关（run 42780589138 实测教训）：没有这一行，下面所有 luci-i18n-*-zh-cn
# 都是不可见符号，会被 defconfig 整批丢弃，成品 LuCI 全英文（manifest 里中文包为 0）。
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ---- SSR Plus（helloworld 源） ----
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Client=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server=y
# 显式关掉 ChinaDNS_NG / MosDNS 两个 Include（符号在上游真实存在）：与 config-12
# 起的既定组合一致（SSR Plus 默认 dns2socks，SmartDNS 管分流，MosDNS 不混入）。
# 注：ssr-plus 的 Nftables_Transparent_Proxy 与 INCLUDE_Http_Proxy 两个符号已被
# 上游删除（24.10 下 ssr-plus 本就 nftables 专用），旧种子里的对应行是死行，已删。
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS is not set
# naive 双路之二：独立 naiveproxy 客户端（/usr/bin/naive）
CONFIG_PACKAGE_naiveproxy=y
# naive 双路之一：coolsnowwolf 版 xray-core 的 Cronet naive 出站（d2 上已验证）
CONFIG_XRAY_CORE_NAIVE=y

# ---- PassWall2（passwall 源，与 SSR Plus 共存） ----
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y

# ---- Yu 选的其他应用（.frpc 口径，官方源均有对应包） ----
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_cloudflared=y
CONFIG_PACKAGE_luci-app-cloudflared=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-udpxy=y
# luci-app-vsftpd 暂缺：依赖 vsftpd-alt，找不到干净来源（见 diy-part2 1c 注），
# 死行先删；将来找到来源把本体行与中文包行一起加回。
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-app-rclone=y
CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-ng=y
CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-webui=y
CONFIG_PACKAGE_luci-app-iptv=y
CONFIG_PACKAGE_luci-app-oui=y

# ---- 中文包 ----
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-cloudflared-zh-cn=y
CONFIG_PACKAGE_luci-i18n-oui-zh-cn=y
CONFIG_PACKAGE_luci-i18n-rclone-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-arpbind-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-udpxy-zh-cn=y
CONFIG_PACKAGE_luci-i18n-filetransfer-zh-cn=y
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y